<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Created: 2026-11-13 14:05 UTC. mgc service health monitor, every 5 min. Copy of
     com.dennis.fleetdev-health-monitor.plist with mgc paths. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dennis.mgc-health-monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/dennishmathes/repos/scripts/MacMiniGC/mgc-health-monitor.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dennishmathes/repos/scripts/MacMiniGC</string>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <!-- Same throttling fix as the other com.dennis scheduled agents (2026-08-05). -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/dennishmathes/Library/Logs/mgc_health_monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dennishmathes/Library/Logs/mgc_health_monitor.log</string>
</dict>
</plist>
