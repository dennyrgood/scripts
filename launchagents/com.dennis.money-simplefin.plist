<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dennis.money-simplefin</string>

    <!-- Daily `money simplefin fetch`: the last 40 days of posted transactions from SimpleFIN Bridge (PSECU,
         Orrstown), kept in ~/MoneyData/simplefin/latest.json for the money app's Import pages. Writes no book:
         Dennis reviews and accepts in the app. The Bridge refreshes from the banks about once a day.
         Added 2026-10-16 (money SPEC §6.12). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/dennishmathes/repos/money/.venv/bin/money</string>
        <string>--config</string>
        <string>/Users/dennishmathes/repos/money/config.toml</string>
        <string>simplefin</string>
        <string>fetch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dennishmathes/repos/money</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <!-- Same as the nightly-summary agents: see mb-health-monitor.plist's comment for the launchd-throttling
         issue this avoids. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/dennishmathes/Library/Logs/money_simplefin.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dennishmathes/Library/Logs/money_simplefin.log</string>
</dict>
</plist>
