<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dennis.fleet-metrics-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/dennishmathes/repos/scripts/Status/fleet_metrics_server.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dennishmathes/repos/scripts/Status</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- 2026-10-18: mb's health monitor caught this server timing out (curl exit 28,
         no reply in 5s) on a launchd-run probe while 60/60 interactive probes a few
         minutes later answered in <10ms; also two self-resolving ~10-min NOT
         RESPONDING alerts (Oct 17 12:36, Oct 18 10:14). Same suspected cause as the
         2026-08-05 health-monitor fix: macOS throttling a Background-class agent.
         ProcessType Interactive opts it out. Shared by every Mac via install.sh. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>/Users/dennishmathes/Library/Logs/fleet_metrics_server.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/dennishmathes/Library/Logs/fleet_metrics_server.log</string>
</dict>
</plist>
