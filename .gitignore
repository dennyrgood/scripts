build/
dist/
dms_util/*.swp
*.un~
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv/
.aider*
# Claude Code machine-local settings (shared config goes in .claude/settings.json)
.claude/settings.local.json

# Timestamped script backups (e.g. nightly_summary.sh.bak.2026-08-25).
# sync-this stages with `git add -A`, so without this rule every ad-hoc backup
# gets committed. Git history is the real backup — all five that had accumulated
# by 2026-08-25 were byte-identical to commits already in the log.
*.bak
*.bak.*

# Generated fleet-scan output mirrored out of OneDrive by scheduled_scan.sh
# (comfy-fleet-http serves this local copy instead of the live-syncing OneDrive
# dir -- see that script's 2026-08-31 comment). Regenerated daily; not source.
comfyui/fleet-output-local/

# Real WiFi credentials for the ESP32 fleet_wall firmware -- see
# esp-firmware/fleet_wall/fleet_wall_secrets.h.example for the template.
# Wildcarded (not just the exact fleet_wall/ path) so ad-hoc local backup
# copies of the project dir (e.g. fleet_wall.backup-*/) can't leak it via
# the auto-sync process's `git add -A`.
esp-firmware/fleet_wall*/fleet_wall_secrets.h

# Same as above, for fleet_wall_image/'s own secrets filename (it also holds
# IMAGE_API_HOST/PORT and WALL_CHANNEL -- no secrets in those, but the file
# is one unit and the WiFi credentials it also carries still need hiding).
esp-firmware/fleet_wall_image/fleet_wall_image_secrets.h

# wall-image/inbox/ is generated output (grid/detail/photo RGB565 frames,
# rewritten by fleet_snapshot_producer.py/photo_producer.py every ~15s) --
# not source, and large binary blobs that shouldn't accumulate in git history.
wall-image/inbox/


# Local backup snapshots of the fleet_wall firmware dir -- not source, just
# a pre-change safety copy; git history is the real backup.
esp-firmware/fleet_wall.backup-*/
comfyui/reports-local/
