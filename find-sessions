#!/usr/bin/env bash
# find-sessions - refresh the Claude session index across the fleet, then open
# a Claude session in ~/claude-sessions to search it.
#
#   find-sessions                 pull remotes, index, merge, launch the finder
#   find-sessions --no-refresh    just launch the finder on the existing index
#   find-sessions --no-launch     refresh only (no interactive session)
#   find-sessions --list          show which machines it would pull (and their OS)
#   find-sessions mb foo          override the machine list (ssh hosts)
#
# The machine list comes from the `alias x='ssh HOST'` lines in ~/.zshrc (this
# box itself is skipped); override with arguments or $FIND_SESSIONS_MACHINES.
# The OS of each box is detected (`uname -s` over ssh: no answer = a Windows
# PowerShell box). Transcripts are pulled with rsync (scp where rsync is
# missing; no --delete, nothing is ever removed) into
# ~/claude-sessions/machines/<machine>/ ; all summarizing runs on THIS box.
# Unreachable machines are skipped and reported; their last copy is reused.

set -u
OUT="$HOME/claude-sessions"
IDX="$(dirname "$0")/claude_sessions_index.py"
LOCAL="$(hostname -s)"
REFRESH=1; LAUNCH=1; LIST=0; MACHINES=()

for arg in "$@"; do
  case "$arg" in
    --no-refresh) REFRESH=0 ;;
    --no-launch)  LAUNCH=0 ;;
    --list)       LIST=1 ;;
    -h|--help)    sed -n '2,15p' "$0"; exit 0 ;;
    *)            MACHINES+=("$arg") ;;
  esac
done

# Used only if ~/.zshrc is missing or has no ssh aliases.
FALLBACK_MACHINES="mb mathes-mac-mini denniss-2nd-macbook-air workbenchunix chatworkhorseunix fleetnas amsterdamdesktop chatworkhorse imagebeast travelbeast remotews surface3-gc surfacegolaptopgc"

# Hosts from `alias x='ssh [opts] HOST'` lines in ~/.zshrc, de-duplicated, minus this box.
# `denniss-macbook-air` is stored as `mb`: that is the label its existing index uses
# (both names are ssh Hosts in ~/.ssh/config).
zshrc_machines() {
  [ -f "$HOME/.zshrc" ] || return 0
  grep -E "^[[:space:]]*alias [A-Za-z0-9_-]+=['\"]?(ssh|mosh)[[:space:]]" "$HOME/.zshrc" \
    | sed -E "s/[[:space:]]#.*$//; s/['\"]+[[:space:]]*$//" | awk '{print $NF}' \
    | sed 's/^denniss-macbook-air$/mb/' | awk -v me="$(printf %s "$LOCAL" | tr 'A-Z' 'a-z')" \
        '!seen[$0]++ && tolower($0) != me'
}

if [ ${#MACHINES[@]} -eq 0 ]; then
  if [ -n "${FIND_SESSIONS_MACHINES:-}" ]; then
    read -r -a MACHINES <<< "$FIND_SESSIONS_MACHINES"
  else
    while IFS= read -r h; do [ -n "$h" ] && MACHINES+=("$h"); done < <(zshrc_machines)
    [ ${#MACHINES[@]} -eq 0 ] && read -r -a MACHINES <<< "$FALLBACK_MACHINES"
  fi
fi

SSHO=(-o BatchMode=yes -o ConnectTimeout=8 -o LogLevel=ERROR)

# is_windows <host>: no `uname -s` answer over ssh means a PowerShell (Windows) box.
# (An unreachable host also lands here; the pull then fails and is reported as such.)
is_windows() {
  local os
  os=$(ssh "${SSHO[@]}" "$1" 'uname -s' 2>/dev/null) && [[ "$os" =~ ^[A-Za-z]+$ ]] && return 1
  return 0
}

if [ "$LIST" -eq 1 ]; then
  echo "machines (${#MACHINES[@]}):"
  for m in "${MACHINES[@]}"; do
    ( if is_windows "$m"; then echo "  $m  windows"; else echo "  $m  unix"; fi ) &
  done
  wait
  exit 0
fi

RSYNC=(rsync -a --timeout=30 -e "ssh ${SSHO[*]}"
       --include='/*/' --include='/*/*.jsonl' --exclude='*')

# pull_one <machine>: copy that machine's ~/.claude/projects into machines/<m>/.
# Windows boxes land in PowerShell: find $HOME, then use rsync via its Cygwin
# path form (/cygdrive/c/...) or, where rsync is missing, scp.
pull_one() {
  local m=$1 dest="$OUT/machines/$1" home drive rest scratch
  mkdir -p "$dest"
  if is_windows "$m"; then
    home=$(ssh "${SSHO[@]}" "$m" '$HOME' | tr -d '\r' | tail -1) || return 1
    [ -n "$home" ] || { echo "cannot read HOME on $m"; return 1; }
    drive=$(printf %s "${home:0:1}" | tr 'A-Z' 'a-z'); rest=${home:2}; rest=${rest//\\//}
    if ssh "${SSHO[@]}" "$m" 'Get-Command rsync -ErrorAction SilentlyContinue' | grep -q .; then
      "${RSYNC[@]}" "$m:/cygdrive/$drive$rest/.claude/projects/" "$dest/"
    else
      scratch=$(mktemp -d)
      # -p / -Rp keep the remote modified times; otherwise every pull looks like
      # a change and the session is re-summarized on every run.
      if scp -r -p -q "${SSHO[@]}" "$m:.claude/projects" "$scratch/"; then
        cp -Rp "$scratch/projects/." "$dest/"; rm -rf "$scratch"
      else
        rm -rf "$scratch"; return 1
      fi
    fi
  else
    "${RSYNC[@]}" "$m:.claude/projects/" "$dest/"
  fi
}

if [ "$REFRESH" -eq 1 ]; then
  mkdir -p "$OUT/index" "$OUT/machines"
  tmp="$(mktemp -d)"

  echo "== pulling transcripts (parallel) =="
  for m in "${MACHINES[@]}"; do
    (
      if pull_one "$m" >"$tmp/$m.log" 2>&1; then
        ok=true
      elif grep -qiE 'no such file|cannot find|does not exist|link_stat|invalid path' "$tmp/$m.log"; then
        ok=true   # reachable, just no ~/.claude/projects yet (no sessions)
      else
        ok=false
      fi
      echo "$ok" > "$tmp/$m.ok"
    ) &
  done
  wait

  for m in "${MACHINES[@]}"; do
    if [ "$(cat "$tmp/$m.ok")" = true ]; then
      n=$(find "$OUT/machines/$m" -maxdepth 2 -name '*.jsonl' | wc -l | tr -d ' ')
      echo "  $m: ok ($n transcripts)"
      # record the last SUCCESSFUL pull time as well
      printf '{"last_attempt":"%s","last_success":"%s","reachable":true}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$OUT/index/$m.sync"
    else
      echo "  $m: UNREACHABLE - using last copy ($(head -c 200 "$tmp/$m.log" | tr '\n' ' '))"
      prev="$(python3 -c "import json,sys;print(json.load(open('$OUT/index/$m.sync')).get('last_success',''))" 2>/dev/null)"
      printf '{"last_attempt":"%s","last_success":"%s","reachable":false}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$prev" > "$OUT/index/$m.sync"
    fi
  done
  rm -rf "$tmp"

  echo "== indexing (only new/changed sessions are summarized) =="
  python3 "$IDX" --root "$HOME/.claude/projects" --machine "$LOCAL" --idle-minutes 0
  for m in "${MACHINES[@]}"; do
    python3 "$IDX" --root "$OUT/machines/$m" --machine "$m" --idle-minutes 0 \
      --skip-dupes-of "$HOME/.claude/projects"
  done
  # claude.ai export: unzips any new zips dropped in machines/WEB/ and summarizes
  # only new/changed chats (asks first if that is more than 100). No-op otherwise.
  python3 "$(dirname "$0")/claude_web_index.py" --out "$OUT"
  python3 "$IDX" --merge
fi

if [ "$LAUNCH" -eq 1 ]; then
  cd "$OUT" && exec claude
fi
