// Copy this file to fleet_wall_image_secrets.h (gitignored) and fill in real values.
#define FLEET_WALL_WIFI_SSID "YOUR_WIFI_SSID"
#define FLEET_WALL_WIFI_PASS "YOUR_WIFI_PASSWORD"

// The Mac (or whatever box) running wall_server.py -- a LAN IP, not a
// Tailscale hostname (the ESP32 has no Tailscale client).
#define IMAGE_API_HOST "192.168.178.241"
#define IMAGE_API_PORT 8099

// Which URL prefix this board polls.
// "/display" -- normal choice: one unified endpoint, the host decides what's
//               showing and what a tap does (fleet grid <-> photos switch
//               via a corner tap, prev/pause/next on photos, tile-tap
//               detail on the fleet grid). See wall_server.py's docstring.
// "/fleet"   -- always the fleet grid, tile-tap-to-detail only, no switch.
// "/photos"  -- always the photo rotation, no tap handling at all.
// Use "/fleet" or "/photos" only for a board you want dedicated to just
// one of those for its whole life -- normally you want "/display".
#define WALL_CHANNEL "/display"
